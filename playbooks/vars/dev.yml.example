---
# Development environment variables.
# Copy this file to dev.yml and fill in your values.
# dev.yml is gitignored and will not be committed.

env: dev
target_namespace: parsec-dev
kubeconfig: ~/secrets/your-cluster.kubeconfig
kubeconfig_context: parsec-dev
cluster_domain: apps.your-cluster.example.com
git_branch: main
oauth_enabled: true

# Vertex AI service account key
vertex_credentials_path: ~/path/to/vertex-sa.json

# GCP billing service account key (separate from Vertex)
gcp_billing_credentials_path: ~/path/to/gcp-billing-sa.json

# Reporting MCP (cross-namespace, demo-reporting)
# reporting_mcp_url: "http://reporting-mcp.demo-reporting.svc:8080/mcp"

# AWS (cost-monitor IAM user)
aws_access_key_id: AKIA...
aws_secret_access_key: your-secret-key

# Azure (billing CSV access)
azure_client_id: your-client-id
azure_client_secret: your-client-secret
azure_tenant_id: your-tenant-id
azure_storage_account: your-storage-account
azure_container: your-container

# GCP (BigQuery billing)
gcp_project_id: your-project-id
gcp_billing_dataset: your_billing_dataset
gcp_billing_account_id: XXXXXX-XXXXXX-XXXXXX

# CloudTrail Lake event data store ID
# Find via: aws cloudtrail list-event-data-stores --region us-east-1
cloudtrail_event_data_store_id: your-event-data-store-uuid

# Cost monitor dashboard URL (for linking in chat responses)
cost_monitor_dashboard_url: https://cost-monitor.apps.your-cluster.example.com

# Alert investigation API key
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
alert_api_key: ""

# AAP2 controller credentials (monitor read-only user)
aap2_east_url: https://aap2-prod-us-east-2.aap.infra.demo.redhat.com
aap2_east_username: monitor
aap2_east_password: ""
aap2_west_url: https://aap2-prod-us-west-2.aap.infra.demo.redhat.com
aap2_west_username: monitor
aap2_west_password: ""
aap2_event0_url: https://event0.apps.ocpv-infra01.dal12.infra.demo.redhat.com
aap2_event0_username: monitor
aap2_event0_password: ""
aap2_partner0_url: https://aap2-partner0-prod-us-east-2.aap.infra.partner.demo.redhat.com
aap2_partner0_username: monitor
aap2_partner0_password: ""

# Reporting MCP token (Bearer auth for reporting-mcp server)
# Create via: POST /api/v1/mcp/tokens {"user_email": "parsec@demo.redhat.com", "name": "parsec-dev"}
reporting_mcp_token: ""

# GitHub PAT (repo scope, for rhpds private repos)
# Used by the fetch_github_file tool (GitHub remote MCP server)
github_token: "ghp_..."

# LiteLLM / LiteMaaS (optional — enables per-component model overrides)
# litellm_base_url: "https://maas-rhdp.apps.maas.redhatworkshops.io"
# litellm_api_key: ""
# litellm_overrides:
#   orchestrator:
#     backend: "litellm"
#     model: "qwen3-14b"

# Allowed users (comma-separated emails, empty = group-based auth only)
allowed_users: ""

# --- Agent runtime (see playbooks/vars/common.yml for the stage ladder) -------
# Uncomment to advance a stage. Reverting the same lines and re-running the
# playbook is the rollback — no image rebuild, no code change.
#
# stage 1 — the Phase-2 pilot: icinga sub-agent on the SDK, legacy routing
# agent_runtime: sdk
#
# stage 2 — all sub-agents on the SDK, still routed by classify_fast.
#           Does NOT fix incorrect routing; that needs stage 3.
# agent_runtime: sdk
# sdk_enabled_agents: ["all"]
#
# stage 3 — full cutover: one SDK session drives the turn and does its own routing
# agent_runtime: sdk
# sdk_enabled_agents: ["all"]
# sdk_orchestrator: true
